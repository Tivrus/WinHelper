<Window x:Class="TransparentHotkeyUtility.UI.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        MouseDown="Window_MouseDown">

    <Window.Resources>

        <!-- ── TextBox с placeholder (через Tag) ───────────────────────────── -->
        <Style x:Key="HintBox" TargetType="TextBox">
            <Setter Property="Background"              Value="Transparent"/>
            <Setter Property="Foreground"              Value="#E1D7FF"/>
            <Setter Property="CaretBrush"              Value="#C8AAFF"/>
            <Setter Property="SelectionBrush"          Value="#7840FF"/>
            <Setter Property="BorderThickness"         Value="0"/>
            <Setter Property="FontFamily"              Value="Segoe UI"/>
            <Setter Property="FontSize"                Value="11"/>
            <Setter Property="Padding"                 Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <!-- Placeholder-текст, видим только когда Text == "" -->
                            <TextBlock x:Name="Hint"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="#70C0AAFF"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       Padding="{TemplateBinding Padding}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"/>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Кнопка «…» с скруглёнными правыми углами ────────────────────── -->
        <Style x:Key="BrowseBtn" TargetType="Button">
            <Setter Property="Background"  Value="#3C2882"/>
            <Setter Property="Foreground"  Value="#E1D7FF"/>
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="FontSize"    Value="14"/>
            <Setter Property="FontWeight"  Value="Bold"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#6E46DC"
                                BorderThickness="1.4"
                                CornerRadius="0,8,8,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5535AA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#231660"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Root-холст на весь экран -->
    <Canvas x:Name="Root" Background="Transparent">

        <!-- Слой коннекторов (линии между кружками) -->
        <Canvas x:Name="LineLayer"/>

        <!-- Слой кружков -->
        <Canvas x:Name="CircleLayer"/>

        <!-- ── Карточка ввода ──────────────────────────────────────────────── -->
        <Border x:Name="InputCard"
                CornerRadius="16"
                Background="#0E0A1A"
                BorderBrush="#6441D2"
                BorderThickness="1.5"
                Width="360">
            <StackPanel Margin="16,14,16,16">

                <!-- Путь к папке -->
                <TextBlock Text="📁  Путь к папке"
                           Foreground="#C8AAFF"
                           FontFamily="Segoe UI"
                           FontSize="12"
                           Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="36"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            CornerRadius="8,0,0,8"
                            Background="#16091E"
                            BorderBrush="#6E46DC"
                            BorderThickness="1.4,1.4,0,1.4"
                            Height="32">
                        <TextBox x:Name="TxtFolder"
                                 Style="{StaticResource HintBox}"
                                 Tag="C:\Projects\myproject"/>
                    </Border>
                    <Button Grid.Column="1"
                            x:Name="BtnBrowse"
                            Content="…"
                            Height="32"
                            Style="{StaticResource BrowseBtn}"
                            Click="BtnBrowse_Click"/>
                </Grid>

                <!-- Репозиторий -->
                <TextBlock Text="🔗  Репозиторий GitHub"
                           Foreground="#C8AAFF"
                           FontFamily="Segoe UI"
                           FontSize="12"
                           Margin="0,14,0,6"/>
                <Border CornerRadius="8"
                        Background="#16091E"
                        BorderBrush="#6E46DC"
                        BorderThickness="1.4"
                        Height="32">
                    <TextBox x:Name="TxtRepo"
                             Style="{StaticResource HintBox}"
                             Tag="https://github.com/user/repo"/>
                </Border>

            </StackPanel>
        </Border>

    </Canvas>
</Window>
