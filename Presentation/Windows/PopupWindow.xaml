<Window x:Class="TransparentHotkeyUtility.Presentation.Windows.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        MouseDown="Window_MouseDown"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>

        <Style x:Key="HintBox" TargetType="TextBox">
            <Setter Property="Background"              Value="Transparent"/>
            <Setter Property="Foreground"              Value="#E1D7FF"/>
            <Setter Property="CaretBrush"              Value="#C8AAFF"/>
            <Setter Property="SelectionBrush"          Value="#7840FF"/>
            <Setter Property="BorderThickness"         Value="0"/>
            <Setter Property="FontFamily"              Value="Segoe UI"/>
            <Setter Property="FontSize"                Value="11"/>
            <Setter Property="Padding"                 Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <TextBlock x:Name="Hint"
                                       Text="{TemplateBinding Tag}"
                                       Foreground="#70C0AAFF"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       Padding="{TemplateBinding Padding}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       IsHitTestVisible="False"
                                       Visibility="Collapsed"/>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Padding="{TemplateBinding Padding}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BrowseBtn" TargetType="Button">
            <Setter Property="Background"  Value="#3C2882"/>
            <Setter Property="Foreground"  Value="#E1D7FF"/>
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="FontSize"    Value="14"/>
            <Setter Property="FontWeight"  Value="Bold"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#6E46DC"
                                BorderThickness="1.4"
                                CornerRadius="0,8,8,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5535AA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#231660"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConfirmBtn" TargetType="Button">
            <Setter Property="Background"  Value="#2A8F5A"/>
            <Setter Property="Foreground"  Value="#F0FFF4"/>
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Padding"     Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#3DB870"
                                BorderThickness="1.2"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#34A868"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F6B42"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardErrorText" TargetType="TextBlock">
            <Setter Property="Foreground"     Value="#FF6B6B"/>
            <Setter Property="FontFamily"     Value="Segoe UI"/>
            <Setter Property="FontSize"       Value="11"/>
            <Setter Property="TextWrapping"   Value="Wrap"/>
            <Setter Property="Margin"         Value="0,8,0,0"/>
            <Setter Property="Visibility"     Value="Collapsed"/>
        </Style>

        <!-- Чекбокс в тёмно-фиолетовой теме -->
        <!-- Навигационные кнопки тулбара настроек (undo / redo / save) -->
        <Style x:Key="SettingsNavBtn" TargetType="Button">
            <Setter Property="Background"  Value="#1E1040"/>
            <Setter Property="Foreground"  Value="#C8AAFF"/>
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="FontSize"    Value="18"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Width"       Value="44"/>
            <Setter Property="Height"      Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#5030A0"
                                BorderThickness="1.4"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C1F6E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#110830"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.28"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопки «Да» / «Нет» в панели подтверждения -->
        <Style x:Key="ConfirmYesBtn" TargetType="Button">
            <Setter Property="Background"  Value="#2A8F5A"/>
            <Setter Property="Foreground"  Value="#F0FFF4"/>
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Padding"     Value="18,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#3DB870"
                                BorderThickness="1.2"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#34A868"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F6B42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConfirmNoBtn" TargetType="Button">
            <Setter Property="Background"  Value="#1E1040"/>
            <Setter Property="Foreground"  Value="#C8AAFF"/>
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Padding"     Value="18,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#5030A0"
                                BorderThickness="1.2"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C1F6E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#110830"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Красная кнопка закрытия (режим настроек) -->
        <Style x:Key="CloseBtn" TargetType="Button">
            <Setter Property="Background"  Value="#B52525"/>
            <Setter Property="Foreground"  Value="#FFFFFF"/>
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="FontSize"    Value="18"/>
            <Setter Property="FontWeight"  Value="Bold"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Width"       Value="44"/>
            <Setter Property="Height"      Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#E03030"
                                BorderThickness="1.4"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D93030"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#7A1515"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопки-стрелки для спиннера радиуса -->
        <Style x:Key="SpinnerBtn" TargetType="Button">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="Foreground"       Value="#9A80CC"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="FontSize"         Value="8"/>
            <Setter Property="Padding"          Value="0"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A2D60"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#251A45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PurpleCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground"  Value="#C8AAFF"/>
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Margin"      Value="0,0,0,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box"
                                    Width="14" Height="14"
                                    CornerRadius="3"
                                    Background="Transparent"
                                    BorderBrush="#6441D2"
                                    BorderThickness="1.5"
                                    VerticalAlignment="Center"/>
                            <TextBlock x:Name="Mark"
                                       Grid.Column="0"
                                       Text="✓"
                                       FontSize="10"
                                       Foreground="#A56AFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                            <ContentPresenter Grid.Column="1"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box"  Property="Background"  Value="#3C2882"/>
                                <Setter TargetName="Box"  Property="BorderBrush" Value="#A56AFF"/>
                                <Setter TargetName="Mark" Property="Visibility"  Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#C8AAFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Пункт списка дочерних кружков в панели настроек -->
        <Style x:Key="ChildItemBtn" TargetType="Button">
            <Setter Property="Background"              Value="Transparent"/>
            <Setter Property="Foreground"              Value="#C8AAFF"/>
            <Setter Property="FontFamily"              Value="Segoe UI"/>
            <Setter Property="FontSize"                Value="11"/>
            <Setter Property="Cursor"                  Value="Hand"/>
            <Setter Property="HorizontalAlignment"     Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding"                 Value="8,5"/>
            <Setter Property="Margin"                  Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C1F6E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A1040"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Маленькая кнопка добавления (+ Текст / + Флажок / + Метка) -->
        <Style x:Key="SmallAddBtn" TargetType="Button">
            <Setter Property="Background"  Value="#24203A"/>
            <Setter Property="Foreground"  Value="#9A80CC"/>
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="FontSize"    Value="10"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Padding"     Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#4A3E70"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C2450"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A1535"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Сегментированный переключатель типа кружка -->
        <Style x:Key="CircleTypeBtn" TargetType="RadioButton">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="Foreground"       Value="#7060AA"/>
            <Setter Property="FontFamily"       Value="Segoe UI"/>
            <Setter Property="FontSize"         Value="11"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="BorderBrush"      Value="#4A3E70"/>
            <Setter Property="BorderThickness"  Value="1,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="6,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3D2875"/>
                                <Setter Property="Foreground" Value="#E1D7FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C1F6E"/>
                                <Setter Property="Foreground" Value="#C8AAFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- Root: DimOverlay → Canvas с фигурой → кнопка закрытия поверх всего -->
    <Grid x:Name="Root">

        <!-- Затемняющий оверлей (виден только в режиме настроек) -->
        <Border x:Name="DimOverlay"
                Background="#99000000"
                Visibility="Collapsed"/>

        <!-- Слой кружков и карточки -->
        <Canvas x:Name="MainCanvas" Background="Transparent">

            <Canvas x:Name="LineLayer"/>
            <Canvas x:Name="CircleLayer"/>

            <Border x:Name="InputCard"
                CornerRadius="16"
                Background="#0E0A1A"
                BorderBrush="#6441D2"
                BorderThickness="1.5"
                Width="360"
                Visibility="Collapsed">
            <StackPanel Margin="16,14,16,16">

                <!-- Технические поля настроек (скрыты из карточки ввода) -->
                <StackPanel x:Name="MainFieldsPanel" Visibility="Collapsed" Height="0">
                    <TextBox x:Name="TxtFolder"
                             Visibility="Collapsed"
                             TextChanged="MainFields_TextChanged"/>
                    <TextBox x:Name="TxtRepo"
                             Visibility="Collapsed"
                             TextChanged="MainFields_TextChanged"/>
                    <Button x:Name="BtnBrowse"
                            Visibility="Collapsed"
                            Click="BtnBrowse_Click"/>
                    <TextBlock x:Name="TxtMainError"
                               Visibility="Collapsed"/>
                </StackPanel>

                <!-- Режим: динамическая форма (Modal-кружок) -->
                <StackPanel x:Name="DynamicFormPanel" Visibility="Collapsed">
                    <StackPanel x:Name="DynamicFieldsHost" Margin="0,0,0,10"/>
                    <Button x:Name="BtnConfirmModal"
                            Content="Confirm"
                            Style="{StaticResource ConfirmBtn}"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,4"
                            Click="BtnConfirmModal_Click"/>
                    <TextBlock x:Name="TxtModalError"
                               Style="{StaticResource CardErrorText}"/>
                </StackPanel>

            </StackPanel>
        </Border>

        </Canvas><!-- конец MainCanvas -->

        <!-- Левая панель настроек: список кружков + кнопки + / 🗑 -->
        <Border x:Name="SettingsPanel"
                HorizontalAlignment="Left"
                VerticalAlignment="Stretch"
                Width="300"
                Background="#181828"
                BorderBrush="#35305A"
                BorderThickness="0,0,1,0"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <Border Grid.Row="0" Background="#0E0A1A" Padding="16,14">
                    <TextBlock Text="⬤  Настройки кружка"
                               Foreground="#C8AAFF"
                               FontFamily="Segoe UI"
                               FontSize="14"
                               FontWeight="SemiBold"/>
                </Border>

                <!-- Свойства выбранного кружка -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              Padding="0,4,0,4">
                    <StackPanel Margin="16,8,16,0">

                        <!-- Подсказка когда ничего не выбрано -->
                        <TextBlock x:Name="SettingsHintText"
                                   Text="Кликните по кружку,&#10;чтобы выбрать его"
                                   Foreground="#4A4060"
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,32,0,0"/>

                        <!-- Поля редактирования (видны только при выбранном кружке) -->
                        <StackPanel x:Name="CirclePropsPanel" Visibility="Collapsed">

                            <!-- Тип кружка -->
                            <TextBlock Text="Тип"
                                       Foreground="#9A80CC"
                                       FontFamily="Segoe UI" FontSize="11"
                                       Margin="0,0,0,5"/>
                            <Border CornerRadius="7" Background="#24203A"
                                    BorderBrush="#4A3E70" BorderThickness="1"
                                    Height="34" Margin="0,0,0,18" ClipToBounds="True">
                                <UniformGrid Columns="3">
                                    <RadioButton x:Name="RbTypeAction"
                                                 Content="Команда"
                                                 GroupName="CircleType"
                                                 BorderThickness="0"
                                                 Style="{StaticResource CircleTypeBtn}"
                                                 ToolTip="Клик сразу выполняет действие (аналог Status / Init)"
                                                 Checked="CircleTypeBtn_Checked"/>
                                    <RadioButton x:Name="RbTypeModal"
                                                 Content="Форма"
                                                 GroupName="CircleType"
                                                 Style="{StaticResource CircleTypeBtn}"
                                                 ToolTip="Клик открывает форму с полями ввода (аналог Save / Add)"
                                                 Checked="CircleTypeBtn_Checked"/>
                                    <RadioButton x:Name="RbTypeGroup"
                                                 Content="Группа"
                                                 GroupName="CircleType"
                                                 Style="{StaticResource CircleTypeBtn}"
                                                 ToolTip="Клик раскрывает вложенные кружки"
                                                 Checked="CircleTypeBtn_Checked"/>
                                </UniformGrid>
                            </Border>

                            <!-- Путь к .exe (только для типа «Команда») -->
                            <StackPanel x:Name="ExeSection" Visibility="Collapsed" Margin="0,0,0,18">
                                <TextBlock Text="Исполняемый файл (.exe)"
                                           Foreground="#9A80CC"
                                           FontFamily="Segoe UI" FontSize="11"
                                           Margin="0,0,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            CornerRadius="7,0,0,7" Background="#24203A"
                                            BorderBrush="#4A3E70" BorderThickness="1,1,0,1"
                                            Height="34">
                                        <TextBox x:Name="PropExePath"
                                                 Background="Transparent"
                                                 Foreground="#E1D7FF" CaretBrush="#C8AAFF"
                                                 SelectionBrush="#7840FF"
                                                 BorderThickness="0"
                                                 FontFamily="Consolas, Courier New" FontSize="11"
                                                 VerticalContentAlignment="Center"
                                                 Padding="10,0"
                                                 LostFocus="PropField_LostFocus"/>
                                    </Border>
                                    <Button Grid.Column="1"
                                            x:Name="BtnBrowseExe"
                                            Content="…"
                                            Height="34"
                                            Style="{StaticResource BrowseBtn}"
                                            ToolTip="Выбрать .exe"
                                            Click="BtnBrowseExe_Click"/>
                                </Grid>
                            </StackPanel>

                            <!-- Поля формы (только для типа «Форма») -->
                            <Border x:Name="FormFieldsSection"
                                    Visibility="Collapsed"
                                    Background="#1A1535"
                                    CornerRadius="7"
                                    BorderBrush="#4A3E70"
                                    BorderThickness="1"
                                    Margin="0,0,0,18"
                                    Padding="10,8">
                                <StackPanel>
                                    <TextBlock Text="Поля формы"
                                               Foreground="#9A80CC"
                                               FontFamily="Segoe UI" FontSize="11"
                                               Margin="0,0,0,8"/>
                                    <StackPanel x:Name="FormFieldListPanel" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="+ Текст"
                                                Style="{StaticResource SmallAddBtn}"
                                                Click="BtnAddTextField_Click"/>
                                        <Button Content="+ Папка"
                                                Style="{StaticResource SmallAddBtn}"
                                                Margin="6,0,0,0"
                                                Click="BtnAddFolderField_Click"/>
                                        <Button Content="+ Флажок"
                                                Style="{StaticResource SmallAddBtn}"
                                                Margin="6,0,0,0"
                                                Click="BtnAddCheckboxField_Click"/>
                                        <Button Content="+ Метка"
                                                Style="{StaticResource SmallAddBtn}"
                                                Margin="6,0,0,0"
                                                Click="BtnAddLabelField_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Текст"
                                       Foreground="#9A80CC"
                                       FontFamily="Segoe UI" FontSize="11"
                                       Margin="0,0,0,5"/>
                            <Border CornerRadius="7" Background="#24203A"
                                    BorderBrush="#4A3E70" BorderThickness="1"
                                    Height="34" Margin="0,0,0,18">
                                <TextBox x:Name="PropLabel"
                                         Background="Transparent"
                                         Foreground="#E1D7FF" CaretBrush="#C8AAFF"
                                         SelectionBrush="#7840FF"
                                         BorderThickness="0"
                                         FontFamily="Segoe UI" FontSize="12"
                                         VerticalContentAlignment="Center"
                                         Padding="10,0"
                                         LostFocus="PropField_LostFocus"/>
                            </Border>

                            <TextBlock Text="Радиус"
                                       Foreground="#9A80CC"
                                       FontFamily="Segoe UI" FontSize="11"
                                       Margin="0,0,0,5"/>
                            <Border CornerRadius="7" Background="#24203A"
                                    BorderBrush="#4A3E70" BorderThickness="1"
                                    Height="34" Margin="0,0,0,18"
                                    PreviewMouseWheel="PropRadius_MouseWheel">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="24"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="PropRadius"
                                             Grid.Column="0"
                                             Background="Transparent"
                                             Foreground="#E1D7FF" CaretBrush="#C8AAFF"
                                             SelectionBrush="#7840FF"
                                             BorderThickness="0"
                                             FontFamily="Segoe UI" FontSize="12"
                                             VerticalContentAlignment="Center"
                                             Padding="10,0"
                                             LostFocus="PropField_LostFocus"/>
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Margin="0,2,3,2">
                                        <Button Content="▲"
                                                Style="{StaticResource SpinnerBtn}"
                                                Height="13" Width="18"
                                                Click="BtnRadiusUp_Click"/>
                                        <Button Content="▼"
                                                Style="{StaticResource SpinnerBtn}"
                                                Height="13" Width="18"
                                                Click="BtnRadiusDown_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="Цвет (HEX)"
                                       Foreground="#9A80CC"
                                       FontFamily="Segoe UI" FontSize="11"
                                       Margin="0,0,0,5"/>
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="PropColorSwatch"
                                        Grid.Column="0"
                                        Width="26" Height="26"
                                        CornerRadius="5"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="#8C4BFF"
                                        Cursor="Hand"
                                        ToolTip="Выбрать цвет"
                                        MouseLeftButtonUp="PropColorSwatch_Click">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Opacity" Value="0.75"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <Border Grid.Column="1"
                                        CornerRadius="7" Background="#24203A"
                                        BorderBrush="#4A3E70" BorderThickness="1"
                                        Height="34">
                                    <TextBox x:Name="PropColor"
                                             Background="Transparent"
                                             Foreground="#E1D7FF" CaretBrush="#C8AAFF"
                                             SelectionBrush="#7840FF"
                                             BorderThickness="0"
                                             FontFamily="Consolas, Courier New" FontSize="12"
                                             VerticalContentAlignment="Center"
                                             Padding="10,0"
                                             CharacterCasing="Upper"
                                             TextChanged="PropColor_TextChanged"
                                             LostFocus="PropField_LostFocus"/>
                                </Border>
                            </Grid>

                            <!-- Дочерние кружки (только для типа «Группа», скрывается при редактировании ребёнка) -->
                            <Border x:Name="ChildrenSection"
                                    Visibility="Collapsed"
                                    Background="#1A1535"
                                    CornerRadius="7"
                                    BorderBrush="#4A3E70"
                                    BorderThickness="1"
                                    Margin="0,14,0,0"
                                    Padding="10,8">
                                <StackPanel>
                                    <TextBlock Text="Дочерние кружки"
                                               Foreground="#9A80CC"
                                               FontFamily="Segoe UI" FontSize="11"
                                               Margin="0,0,0,8"/>
                                    <ScrollViewer MaxHeight="130"
                                                  VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="ChildListPanel"/>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Нижняя панель: чекбокс + кнопки добавить / удалить -->
                <Border Grid.Row="2" Background="#0E0A1A" Padding="12,10">
                    <StackPanel>
                        <!-- Настройка позиции появления фигуры -->
                        <CheckBox x:Name="ChkSpawnAtCursor"
                                  Content="🖱  На курсоре мыши"
                                  Style="{StaticResource PurpleCheckBox}"
                                  HorizontalAlignment="Center"
                                  Margin="0,0,0,10"
                                  ToolTip="Включено — фигура появляется под курсором.&#10;Выключено — фигура появляется по центру экрана."/>
                        <!-- Настройка хоткея вызова -->
                        <TextBlock Text="Хоткей вызова"
                                   Foreground="#9A80CC"
                                   FontFamily="Segoe UI" FontSize="11"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,4"/>
                        <Border CornerRadius="7" Background="#24203A"
                                BorderBrush="#4A3E70" BorderThickness="1"
                                Height="30" Margin="10,0,10,14">
                            <TextBox x:Name="TxtHotkey"
                                     Background="Transparent"
                                     Foreground="#E1D7FF" CaretBrush="#C8AAFF"
                                     SelectionBrush="#7840FF"
                                     BorderThickness="0"
                                     FontFamily="Segoe UI" FontSize="11"
                                     VerticalContentAlignment="Center"
                                     HorizontalContentAlignment="Center"
                                     IsReadOnly="True"
                                     Cursor="Hand"
                                     ToolTip="Кликните, чтобы задать новый хоткей"
                                     PreviewKeyDown="TxtHotkey_PreviewKeyDown"
                                     GotFocus="TxtHotkey_GotFocus"
                                     LostFocus="TxtHotkey_LostFocus"/>
                        </Border>
                        <!-- Кнопки управления кружками -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="BtnAddCircle"
                                    Content="+"
                                    ToolTip="Добавить кружок"
                                    Style="{StaticResource SettingsNavBtn}"
                                    FontSize="22"
                                    Margin="0,0,10,0"
                                    Click="BtnAddCircle_Click"/>
                            <Button x:Name="BtnDeleteCircle"
                                    Content="🗑"
                                    ToolTip="Удалить выбранный кружок"
                                    Style="{StaticResource SettingsNavBtn}"
                                    IsEnabled="False"
                                    Click="BtnDeleteCircle_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Тулбар настроек: ↩ ↪ 💾 ✕ — виден только в режиме настроек -->
        <StackPanel x:Name="SettingsToolbar"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,20,20,0"
                    Visibility="Collapsed">
            <Button x:Name="BtnSettingsUndo"
                    Content="↩"
                    ToolTip="Отменить изменение"
                    Style="{StaticResource SettingsNavBtn}"
                    Margin="0,0,6,0"
                    Click="BtnSettingsUndo_Click"/>
            <Button x:Name="BtnSettingsRedo"
                    Content="↪"
                    ToolTip="Повторить изменение"
                    Style="{StaticResource SettingsNavBtn}"
                    Margin="0,0,6,0"
                    Click="BtnSettingsRedo_Click"/>
            <Button x:Name="BtnSettingsSave"
                    Content="💾"
                    ToolTip="Сохранить настройки"
                    Style="{StaticResource SettingsNavBtn}"
                    Margin="0,0,6,0"
                    Click="BtnSettingsSave_Click"/>
            <Button x:Name="BtnClose"
                    Content="✕"
                    ToolTip="Закрыть"
                    Style="{StaticResource CloseBtn}"
                    Click="BtnClose_Click"/>
        </StackPanel>

        <!-- Панель подтверждения: «Сохранить изменения?» -->
        <Border x:Name="ConfirmClosePanel"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,74,20,0"
                Background="#130A24"
                BorderBrush="#6441D2"
                BorderThickness="1.4"
                CornerRadius="12"
                Padding="16,14"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Сохранить изменения?"
                           Foreground="#C8AAFF"
                           FontFamily="Segoe UI"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Да"
                            Style="{StaticResource ConfirmYesBtn}"
                            Margin="0,0,8,0"
                            Click="BtnConfirmSaveYes_Click"/>
                    <Button Content="Нет"
                            Style="{StaticResource ConfirmNoBtn}"
                            Click="BtnConfirmSaveNo_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

    </Grid><!-- конец Root -->
</Window>
